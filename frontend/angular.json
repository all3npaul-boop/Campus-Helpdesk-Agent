{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "campus-ai": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "campus",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/campus-ai",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "/assets"
              }
            ],
            "styles": [
              "src/styles.css"
            ],
            "budgets": [
              {
                "type": "initial",
                "maximumWarning": "800kB",
                "maximumError": "2MB"
              },
              {
                "type": "anyComponentStyle",
                "maximumWarning": "16kB",
                "maximumError": "32kB"
              }
            ],
            "optimization": {
              "scripts": true,
              "styles": {
                "minify": true,
                "inlineCritical": false
              },
              "fonts": false
            }
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "campus-ai:build"
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}