+.a-nav .a-count { margin-left: auto; font-size: 11.5px; font-weight: 700; padding: 2px 7px; border-radius: 999px; background: var(--burgundy-50); color: var(--burgundy-700); }
+.a-nav .a-soon { margin-left: auto; font-size: 10.5px; font-weight: 600; color: var(--faint); }
+.a-side-foot { margin-top: auto; padding-top: 14px; border-top: 1px solid var(--line); display: flex; flex-direction: column; gap: 4px; }
+.a-back { display: flex; align-items: center; gap: 11px; min-height: 40px; padding: 0 12px; border-radius: 10px; font-size: 13.5px; font-weight: 600; color: var(--muted); }
