+.a-console { font-size: 11.5px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--burgundy-700); background: var(--burgundy-50); border: 1px solid #f0cdd4; padding: 5px 10px; border-radius: 999px; white-space: nowrap; }
+.a-tools { margin-left: auto; display: flex; align-items: center; gap: 12px; }
+.a-user { display: flex; align-items: center; gap: 10px; }
+.a-avatar { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: var(--navy-100); border: 1px solid var(--navy-200); color: var(--navy-900); font-weight: 700; font-size: 13px; }
