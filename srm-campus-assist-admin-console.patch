+.a-signout { display: inline-flex; align-items: center; gap: 9px; min-height: 38px; padding: 0 12px; border-radius: 10px; font-size: 13.5px; font-weight: 600; color: var(--burgundy-700); border: 1px solid transparent; transition: background 0.15s, border-color 0.15s; }
