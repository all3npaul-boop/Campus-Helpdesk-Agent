+.a-soon-page .a-pill { font-size: 11.5px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; padding: 4px 10px; border-radius: 999px; background: var(--amber-50); color: var(--amber); }
+
+/* ---------- Responsive ---------- */
+@media (max-width: 900px) {
+  .a-menu-btn { display: grid; }
+  .a-side { position: fixed; top: var(--a-top); left: 0; z-index: 40; transform: translateX(-100%); transition: transform 0.2s; box-shadow: var(--shadow-md); }
