+  .a-scrim { display: block; position: fixed; inset: var(--a-top) 0 0 0; z-index: 35; background: rgba(7, 23, 51, 0.35); }
+  .a-main { padding: 18px 16px 48px; }
+  .a-user-text, .a-top .a-signout span { display: none; }
+  .a-brand-text span { display: none; }
+}
+@media (max-width: 640px) { .a-console { display: none; } }
