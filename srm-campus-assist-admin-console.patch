+.a-search ui-icon { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--faint); pointer-events: none; }
+.a-input, .a-select, .a-textarea { width: 100%; min-height: 40px; padding: 0 12px; border: 1px solid var(--line-strong); border-radius: 10px; background: #fff; font-size: 14px; color: var(--text); transition: border-color 0.15s, box-shadow 0.15s; }
+.a-search .a-input { padding-left: 36px; }
+.a-select { width: auto; min-width: 140px; padding-right: 8px; }
+.a-textarea { padding: 10px 12px; min-height: 84px; resize: vertical; line-height: 1.45; }
+.a-input:focus, .a-select:focus, .a-textarea:focus { outline: none; border-color: var(--navy-700); box-shadow: 0 0 0 3px rgba(27, 65, 135, 0.14); }
+.a-clear { font-size: 13px; font-weight: 600; color: var(--navy-700); padding: 8px 10px; border-radius: 8px; }
+.a-clear:hover { background: var(--navy-50); }
+.a-result-count { margin-left: auto; font-size: 13px; color: var(--muted); }
+
+/* ---------- Buttons ---------- */
+.a-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 38px; padding: 0 14px; border-radius: 10px; font-size: 14px; font-weight: 600; white-space: nowrap; border: 1px solid transparent; transition: background 0.15s, border-color 0.15s, transform 0.1s; }
+.a-btn:active:not(:disabled) { transform: scale(0.98); }
+.a-btn:disabled { opacity: 0.45; }
+.a-btn.primary { background: var(--burgundy-600); color: #fff; } .a-btn.primary:hover:not(:disabled) { background: var(--burgundy-700); }
+.a-btn.navy { background: var(--navy-900); color: #fff; } .a-btn.navy:hover:not(:disabled) { background: var(--navy-800); }
+.a-btn.secondary { background: #fff; color: var(--navy-900); border-color: var(--line-strong); } .a-btn.secondary:hover:not(:disabled) { background: var(--navy-50); border-color: var(--navy-200); }
+.a-btn.danger { background: #fff; color: var(--burgundy-700); border-color: #e7bcc5; } .a-btn.danger:hover:not(:disabled) { background: var(--burgundy-50); }
+.a-btn.success { background: var(--green); color: #fff; } .a-btn.success:hover:not(:disabled) { background: #125a3b; }
+
+/* ---------- States ---------- */
