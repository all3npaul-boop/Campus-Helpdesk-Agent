+
+/* ---------- Sidebar ---------- */
+.a-body { display: flex; align-items: flex-start; }
+.a-side { position: sticky; top: var(--a-top); flex: none; width: var(--a-side); height: calc(100dvh - var(--a-top)); display: flex; flex-direction: column; padding: 16px 12px; background: var(--surface); border-right: 1px solid var(--line); overflow-y: auto; }
