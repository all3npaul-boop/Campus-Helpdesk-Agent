+/* SRM Campus Assist — Admin Console. Classes are prefixed `a-` (component uses ViewEncapsulation.None so child pages share them). */
+.adm { min-height: 100dvh; background: var(--bg); --a-side: 236px; --a-top: 60px; }
+.adm .mono { font-variant-numeric: tabular-nums; letter-spacing: 0.01em; }
+.adm .a-sr { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
+
+/* ---------- Top bar ---------- */
+.a-top { position: sticky; top: 0; z-index: 30; height: var(--a-top); display: flex; align-items: center; gap: 14px; padding: 0 20px; background: var(--surface); border-bottom: 1px solid var(--line); }
