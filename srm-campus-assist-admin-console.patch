+.a-desc { font-size: 14.5px; line-height: 1.6; color: var(--text); }
+.a-facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px 20px; margin: 0; }
+.a-facts dt { font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
+.a-facts dd { margin: 3px 0 0; font-size: 14px; font-weight: 600; color: var(--navy-900); overflow-wrap: anywhere; }
+.a-facts dd small { display: block; font-weight: 500; font-size: 12px; color: var(--faint); }
+.a-banner { display: flex; gap: 10px; align-items: flex-start; padding: 12px 14px; border-radius: 11px; font-size: 13.5px; margin-bottom: 14px; }
+.a-banner ui-icon { margin-top: 1px; }
+.a-banner.warn { background: var(--burgundy-50); color: var(--burgundy-700); border: 1px solid #f0cdd4; }
+.a-banner.info { background: #eee8fb; color: #47308a; border: 1px solid #ddd2f6; }
+.a-banner.ok { background: var(--green-50); color: var(--green); border: 1px solid #c6e5d3; }
+.a-ai { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px 22px; margin: 0; }
+.a-ai dt { font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
+.a-ai dd { margin: 3px 0 0; font-size: 14px; font-weight: 600; color: var(--navy-900); }
+.a-ai .wide { grid-column: 1 / -1; }
+.a-ai .suggest { padding: 10px 12px; border-radius: 10px; background: var(--navy-50); border: 1px solid var(--navy-100); }
+.a-timeline { position: relative; display: grid; gap: 0; }
+.a-timeline li { position: relative; display: grid; grid-template-columns: 78px minmax(0, 1fr); gap: 14px; padding: 0 0 16px 20px; font-size: 13.5px; }
+.a-timeline li:last-child { padding-bottom: 0; }
+.a-timeline li::before { content: ''; position: absolute; left: 4px; top: 6px; width: 9px; height: 9px; border-radius: 50%; background: var(--navy-200); border: 2px solid #fff; box-shadow: 0 0 0 1px var(--navy-200); z-index: 1; }
+.a-timeline li::after { content: ''; position: absolute; left: 8px; top: 16px; bottom: -6px; width: 1px; background: var(--line-strong); }
+.a-timeline li:last-child::after { display: none; }
+.a-timeline li[data-a='Admin']::before { background: var(--burgundy-600); box-shadow: 0 0 0 1px var(--burgundy-600); }
+.a-timeline li[data-a='AI']::before { background: #7a56cf; box-shadow: 0 0 0 1px #7a56cf; }
+.a-timeline time { font-weight: 600; color: var(--muted); font-variant-numeric: tabular-nums; white-space: nowrap; }
+.a-timeline .t small { display: block; margin-top: 1px; font-size: 11.5px; color: var(--faint); }
+
+/* Actions panel */
+.a-actions { display: grid; gap: 8px; padding: 14px 16px; }
+.a-actions .a-btn { justify-content: flex-start; width: 100%; }
+.a-form { display: grid; gap: 10px; padding: 14px; margin-top: 4px; border: 1px solid var(--navy-100); background: var(--navy-50); border-radius: 12px; }
+.a-form label { font-size: 12.5px; font-weight: 700; color: var(--navy-900); }
+.a-form .a-select { width: 100%; }
+.a-form-row { display: flex; gap: 8px; justify-content: flex-end; }
+.a-hint { font-size: 12px; color: var(--muted); }
+.a-flash { position: fixed; right: 22px; bottom: 22px; z-index: 60; display: flex; align-items: center; gap: 10px; max-width: min(380px, calc(100vw - 32px)); padding: 12px 16px; border-radius: 12px; background: var(--navy-900); color: #fff; font-size: 14px; font-weight: 600; box-shadow: var(--shadow-md); }
+.a-flash ui-icon { color: #7ee2b0; }
+.a-summary { display: grid; gap: 10px; padding: 14px 16px; font-size: 13.5px; }
+.a-summary div { display: flex; justify-content: space-between; gap: 12px; }
+.a-summary dt { font-size: 12px; text-transform: none; letter-spacing: 0; color: var(--muted); font-weight: 600; }
+.a-summary dd { margin: 0; font-weight: 700; color: var(--navy-900); text-align: right; }
+.a-summary .risk { color: var(--burgundy-600); }
+
+/* ---------- Responsive ---------- */
+@media (max-width: 1080px) { .a-detail { grid-template-columns: minmax(0, 1fr); } .a-detail-side { position: static; } }
+@media (max-width: 640px) {
+  .a-facts, .a-ai { grid-template-columns: minmax(0, 1fr); }
+  .a-timeline li { grid-template-columns: 64px minmax(0, 1fr); gap: 10px; }
+}
