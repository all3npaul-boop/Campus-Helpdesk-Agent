+
+/* ---------- Page head ---------- */
+.page-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
+h1 { font-size: clamp(28px, 4vw, 36px); line-height: 1.1; letter-spacing: -0.03em; font-weight: 800; color: var(--navy-900); }
+.subtitle { margin-top: 6px; color: var(--muted); font-size: 16px; }
+
+/* ---------- Buttons (same language as the assistant's cards) ---------- */
+.btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 44px; padding: 0 18px; border-radius: 12px; font-weight: 600; font-size: 15px; white-space: nowrap; transition: background 0.15s, border-color 0.15s, transform 0.1s; }
+.btn:active:not(:disabled) { transform: scale(0.98); }
+.btn.primary { background: var(--burgundy-600); color: #fff; }
+.btn.primary:hover { background: var(--burgundy-700); }
+.btn.secondary { background: #fff; color: var(--navy-900); border: 1px solid var(--line-strong); }
+.btn.secondary:hover { background: var(--navy-50); border-color: var(--navy-200); }
+
+/* ---------- Summary ---------- */
+.summary { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: 28px 0 0; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-md); box-shadow: var(--shadow-sm); }
+.summary > div { display: flex; flex-direction: column-reverse; gap: 2px; padding: 16px 20px; border-left: 1px solid var(--line); min-width: 0; }
+.summary > div:first-child { border-left: 0; }
+.summary dt { font-size: 12.5px; font-weight: 600; color: var(--muted); }
+.summary dd { margin: 0; font-size: 28px; line-height: 1.1; font-weight: 800; letter-spacing: -0.02em; color: var(--navy-900); }
+.summary .attention dd { color: var(--burgundy-600); }
+
+/* ---------- Filters ---------- */
+.filters { display: flex; flex-wrap: wrap; gap: 8px; margin: 20px 0 20px; }
+.filter { display: inline-flex; align-items: center; gap: 8px; min-height: 40px; padding: 0 14px; border-radius: 999px; font-size: 14px; font-weight: 600; color: var(--muted); background: var(--surface); border: 1px solid var(--line-strong); transition: background 0.15s, border-color 0.15s, color 0.15s; }
+.filter:hover { background: var(--navy-50); color: var(--navy-900); }
+.filter.on { background: var(--navy-900); border-color: var(--navy-900); color: #fff; }
+.count { font-size: 12px; font-weight: 700; min-width: 20px; padding: 2px 6px; border-radius: 999px; background: var(--navy-100); color: var(--navy-900); text-align: center; }
+.filter.on .count { background: rgba(255, 255, 255, 0.2); color: #fff; }
+
+/* ---------- Request cards ---------- */
+.list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
+.list > li { display: flex; min-width: 0; }
+.card { display: flex; flex-direction: column; width: 100%; padding: 20px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-md); box-shadow: var(--shadow-sm); transition: border-color 0.15s, box-shadow 0.15s; }
+.card:hover, .card:focus-within { border-color: var(--navy-200); box-shadow: var(--shadow-md); }
+.card.needs-action { border-color: #ebc3cb; border-top: 4px solid var(--burgundy-600); }
+.card > header { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
+.cat { display: inline-flex; align-items: center; gap: 10px; min-width: 0; font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--navy-800); }
+.tile { display: grid; place-items: center; flex: none; width: 34px; height: 34px; border-radius: 10px; background: var(--navy-50); color: var(--navy-800); }
+.card h2 { margin-top: 14px; font-size: 20px; letter-spacing: -0.01em; color: var(--navy-900); }
+.issue { margin-top: 2px; font-weight: 600; }
+.desc { color: var(--muted); font-size: 14px; margin-top: 2px; }
+.notice { display: flex; align-items: center; gap: 6px; margin-top: 12px; font-size: 13.5px; font-weight: 600; color: var(--burgundy-700); }
+.meta { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 12px 28px; margin: 16px 0 0; padding-top: 14px; border-top: 1px solid var(--line); }
+dt { font-size: 11px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
+dd { margin: 2px 0 0; font-weight: 600; font-size: 14px; overflow-wrap: anywhere; }
+.card footer { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-top: auto; padding-top: 16px; }
+.prov { display: inline-flex; align-items: flex-start; gap: 6px; flex: 1 1 200px; min-width: 0; font-size: 12.5px; color: var(--muted); }
+.prov ui-icon { color: var(--green); margin-top: 1px; }
+
+/* Status pill with a colour dot (colour is never the only signal: the text is always shown) */
+.status { display: inline-flex; align-items: center; gap: 7px; flex: none; font-size: 12.5px; font-weight: 600; line-height: 1; padding: 7px 11px; border-radius: 999px; white-space: nowrap; }
+.status i { width: 8px; height: 8px; border-radius: 50%; background: currentColor; }
+.status.navy { color: var(--navy-800); background: var(--navy-100); }
+.status.amber { color: var(--amber); background: var(--amber-50); }
+.status.green { color: var(--green); background: var(--green-50); }
+.status.red { color: var(--burgundy-700); background: var(--burgundy-50); }
+
+/* ---------- Empty ---------- */
+.empty { display: grid; justify-items: center; gap: 10px; margin-top: 32px; padding: 56px 24px; text-align: center; background: var(--surface); border: 1px dashed var(--line-strong); border-radius: var(--radius-lg); }
+.empty.compact { padding: 40px 24px; margin-top: 8px; color: var(--muted); }
+.empty-icon { display: grid; place-items: center; width: 64px; height: 64px; border-radius: 20px; background: var(--navy-50); color: var(--navy-800); }
+.empty h2 { font-size: 22px; letter-spacing: -0.01em; color: var(--navy-900); }
+.empty p { max-width: 420px; color: var(--muted); }
+.empty .btn { margin-top: 8px; }
+.assurance { display: flex; align-items: flex-start; gap: 8px; margin-top: 28px; color: var(--muted); font-size: 13px; }
+.assurance ui-icon { color: var(--green); margin-top: 1px; }
+
+/* ---------- Details: side drawer on desktop, bottom sheet on mobile ---------- */
+.scrim { position: fixed; inset: 0; z-index: 40; background: rgba(7, 23, 51, 0.5); animation: fade 0.18s ease-out; }
+.sheet { position: fixed; z-index: 50; top: 0; right: 0; bottom: 0; width: min(460px, 100vw); display: flex; flex-direction: column; background: var(--surface); box-shadow: -12px 0 40px rgba(7, 23, 51, 0.25); animation: slide-in 0.22s ease-out; }
+.grab { display: none; }
+.sheet-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; padding: 24px 24px 16px; border-bottom: 1px solid var(--line); }
+.eyebrow { font-size: 12px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: var(--burgundy-600); }
+.sheet-head h2 { margin-top: 2px; font-size: 22px; letter-spacing: -0.01em; color: var(--navy-900); }
+.rid { margin-top: 2px; color: var(--muted); font-weight: 600; }
+.x { display: grid; place-items: center; flex: none; width: 44px; height: 44px; margin: -6px -8px 0 0; border-radius: 999px; color: var(--navy-900); transition: background 0.15s; }
+.x:hover { background: var(--navy-50); }
+.sheet-body { flex: 1; overflow-y: auto; overscroll-behavior: contain; padding: 20px 24px; display: grid; gap: 24px; align-content: start; }
+.facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
+.facts dd { font-size: 15px; }
+.sheet h3 { font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--navy-800); margin-bottom: 12px; }
+
+.timeline { display: grid; gap: 0; list-style: none; margin: 0; padding: 0; }
+.timeline li { position: relative; display: flex; gap: 14px; padding-bottom: 18px; }
+.timeline li:last-child { padding-bottom: 0; }
+.timeline li::before { content: ''; position: absolute; left: 11px; top: 26px; bottom: 2px; width: 2px; background: var(--line-strong); }
+.timeline li:last-child::before { display: none; }
+.timeline li.done::before { background: var(--green); }
+.node { display: grid; place-items: center; flex: none; width: 24px; height: 24px; border-radius: 50%; border: 2px solid var(--line-strong); background: #fff; color: #fff; }
+.done .node { background: var(--green); border-color: var(--green); }
+.current .node { border-color: var(--burgundy-600); box-shadow: 0 0 0 4px var(--burgundy-50); }
+.current .node::after { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--burgundy-600); animation: pulse 1.6s ease-in-out infinite; }
+.step { display: flex; flex-direction: column; line-height: 1.35; min-width: 0; padding-top: 2px; }
+.step strong { font-size: 14.5px; color: var(--navy-900); }
+.todo .step strong { color: var(--faint); font-weight: 600; }
+.state-text { font-size: 12.5px; color: var(--muted); }
+.updated { display: flex; align-items: center; gap: 6px; margin-top: 16px; font-size: 13px; color: var(--muted); }
+.origin { padding: 14px 16px; border-radius: 14px; background: var(--navy-50); border: 1px solid var(--navy-100); }
+.origin h3 { margin-bottom: 6px; }
+.origin p { font-size: 14px; }
+.demo { font-size: 12px; color: var(--faint); }
+.sheet-actions { display: flex; gap: 10px; padding: 16px 24px calc(16px + env(safe-area-inset-bottom)); border-top: 1px solid var(--line); background: var(--surface); }
+.sheet-actions .primary { flex: 1; }
+
+@keyframes fade { from { opacity: 0; } to { opacity: 1; } }
+@keyframes slide-in { from { transform: translateX(32px); opacity: 0; } to { transform: none; opacity: 1; } }
+@keyframes slide-up { from { transform: translateY(32px); opacity: 0; } to { transform: none; opacity: 1; } }
+@keyframes pulse { 50% { transform: scale(1.5); opacity: 0.5; } }
+
+/* ---------- Responsive ---------- */
+@media (max-width: 899px) {
+  .list { grid-template-columns: 1fr; }
+}
+@media (max-width: 720px) {
+  .page { padding: 20px 16px 40px; }
+  .page-head .btn { width: 100%; }
+  .summary { margin-top: 20px; }
+  .summary > div { padding: 12px 10px; }
+  .summary dd { font-size: 24px; }
+  .summary dt { font-size: 11.5px; }
+  .filters { gap: 6px; }
+  .filter { padding: 0 12px; font-size: 13.5px; }
+  .card { padding: 16px; }
+  .card footer .btn { width: 100%; }
+  .prov { flex-basis: 100%; }
+  .sheet { top: auto; left: 0; right: 0; width: 100%; max-height: 92dvh; border-radius: 24px 24px 0 0; box-shadow: 0 -12px 40px rgba(7, 23, 51, 0.3); animation: slide-up 0.24s ease-out; }
+  .grab { display: block; width: 40px; height: 4px; margin: 10px auto 0; border-radius: 2px; background: var(--line-strong); }
+  .sheet-head { padding: 12px 16px 12px; }
+  .sheet-body { padding: 16px; }
+  .sheet-actions { padding: 12px 16px calc(12px + env(safe-area-inset-bottom)); }
+}
+@media (max-width: 520px) {
+  .summary { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .summary > div { border-left: 0; border-top: 1px solid var(--line); padding: 12px 16px; }
+  .summary > div:nth-child(-n + 2) { border-top: 0; }
+  .summary > div:nth-child(even) { border-left: 1px solid var(--line); }
+}
+@media (max-width: 380px) { .meta { grid-template-columns: minmax(0, 1fr); gap: 10px; } .facts { grid-template-columns: 1fr; } }
