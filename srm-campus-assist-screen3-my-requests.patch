+      <div>
+        <span class="eyebrow">{{ category(r) }}</span>
+        <h2 id="dlg-title">{{ r.title }}</h2>
+        <p class="rid mono">{{ r.id }}</p>
+      </div>
+      <button type="button" class="x" #closeBtn (click)="close()" aria-label="Close details"><ui-icon name="x" [size]="20" /></button>
+    </header>
+
+    <div class="sheet-body">
+      <dl class="facts">
+        @for (f of fields(r); track f.label) { <div><dt>{{ f.label }}</dt><dd>{{ f.value }}</dd></div> }
+        <div><dt>Submitted</dt><dd>{{ when(submitted(r)) }}</dd></div>
+        <div><dt>Status</dt><dd><span [class]="'status ' + tone(r.status)"><i aria-hidden="true"></i>{{ r.status }}</span></dd></div>
+      </dl>
+
+      <section aria-labelledby="progress-title">
+        <h3 id="progress-title">Progress</h3>
+        <ol class="timeline">
+          @for (s of timeline(r); track s.label) {
+            <li [class]="s.state">
+              <span class="node" aria-hidden="true">@if (s.state === 'done') { <ui-icon name="check" [size]="12" /> }</span>
+              <span class="step">
+                <strong>{{ s.label }}</strong>
+                <span class="state-text">@switch (s.state) { @case ('done') { Done } @case ('current') { In progress } @default { Not started } }@if (s.at) { · {{ when(s.at) }} }</span>
+              </span>
+            </li>
+          }
+        </ol>
+        <p class="updated"><ui-icon name="clock" [size]="14" /> Last updated {{ ago(r.updatedAt) }}</p>
+      </section>
+
+      @if (r.origin) {
+        <section class="origin" aria-labelledby="origin-title">
+          <h3 id="origin-title">How this request was created</h3>
+          <p>Prepared by Campus Assist@if (r.origin.confirmedByStudent) { and confirmed by you on {{ when(r.origin.confirmedAt) }}}. Nothing was submitted before you confirmed.</p>
+        </section>
+      }
+      <p class="demo">Demo request · sample data, not an official SRMIST record.</p>
+    </div>
+
+    <footer class="sheet-actions">
+      <button type="button" class="btn primary" (click)="openAssistant(r)"><ui-icon name="sparkles" [size]="18" /> Open Assistant</button>
+      <button type="button" class="btn secondary" (click)="close()">Close</button>
+    </footer>
+  </aside>
+}
