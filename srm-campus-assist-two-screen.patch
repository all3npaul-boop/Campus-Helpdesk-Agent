+    <section class="card" [attr.aria-label]="request().title + ' request status'">
+      <header>
+        <div>
+          <span class="eyebrow">{{ request().title }}</span>
+          <p class="id">{{ request().id }}</p>
+        </div>
+        <span [class]="'badge ' + tone(request().status)">{{ request().status }}</span>
+      </header>
+      <dl>
