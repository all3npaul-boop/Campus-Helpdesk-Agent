+:host { display: block; height: 100dvh; }
+.shell { height: 100%; display: flex; flex-direction: column; background: var(--bg); }
+
+/* ---------- Header ---------- */
+.a-header { flex: none; display: flex; align-items: center; gap: 12px; height: 68px; padding: 0 24px; background: var(--navy-900); color: #fff; }
+.back { display: grid; place-items: center; width: 44px; height: 44px; margin-left: -8px; border-radius: 999px; transition: background .15s; }
+.back:hover { background: rgba(255,255,255,.14); }
+.a-header :focus-visible { outline-color: #fff; }
+.mark { position: relative; display: grid; place-items: center; width: 38px; height: 38px; border-radius: 10px; background: #fff; color: var(--navy-900); font-weight: 800; font-size: 11px; overflow: hidden; }
+.mark::after { content: ''; position: absolute; left: 8px; right: 8px; bottom: 5px; height: 3px; border-radius: 2px; background: var(--burgundy-600); }
+.titles { min-width: 0; line-height: 1.2; }
+.titles h1 { font-size: 17px; font-weight: 700; letter-spacing: -.01em; white-space: nowrap; }
+.titles p { font-size: 12.5px; color: #b9c7e3; }
+.online { margin-left: auto; display: inline-flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 600; padding: 6px 12px; border-radius: 999px; background: rgba(255,255,255,.1); white-space: nowrap; }
+.online i { width: 8px; height: 8px; border-radius: 50%; background: #4bd28f; box-shadow: 0 0 0 3px rgba(75,210,143,.25); }
+
+/* ---------- Layout ---------- */
+.body { flex: 1; min-height: 0; display: grid; grid-template-columns: minmax(0, 1fr) 340px; }
+.convo { display: flex; flex-direction: column; min-height: 0; min-width: 0; }
+.scroller { flex: 1; overflow-y: auto; overscroll-behavior: contain; padding: 28px 24px 12px; }
+.thread { max-width: 820px; margin: 0 auto; display: grid; gap: 22px; }
+
+/* ---------- Messages ---------- */
+.row { display: flex; min-width: 0; }
+.row.student { flex-direction: column; align-items: flex-end; gap: 4px; }
+.bubble { max-width: min(560px, 88%); background: var(--navy-900); color: #fff; padding: 12px 16px; border-radius: 20px 20px 6px 20px; overflow-wrap: anywhere; white-space: pre-wrap; }
+time { font-size: 12px; color: var(--muted); }
+.row.agent { gap: 12px; align-items: flex-start; }
+.agent-avatar { display: grid; place-items: center; flex: none; width: 36px; height: 36px; border-radius: 12px; background: var(--navy-900); color: #fff; }
+.row.error .agent-avatar { background: var(--red); }
+.agent-body { flex: 1; min-width: 0; max-width: 720px; }
+.meta { display: flex; align-items: baseline; gap: 8px; margin-bottom: 4px; }
+.meta strong { font-size: 13.5px; color: var(--navy-900); }
+.text { background: var(--surface); border: 1px solid var(--line); padding: 12px 16px; border-radius: 6px 20px 20px 20px; box-shadow: var(--shadow-sm); overflow-wrap: anywhere; }
+.row.error .text { border-color: #ebc3cb; background: var(--burgundy-50); }
+
+.dots { display: flex; align-items: center; gap: 5px; }
+.dots span { width: 7px; height: 7px; border-radius: 50%; background: var(--navy-700); animation: bounce 1.1s ease-in-out infinite; }
+.dots span:nth-child(2) { animation-delay: .15s; }
+.dots span:nth-child(3) { animation-delay: .3s; }
+.dots em { margin-left: 8px; font-style: normal; font-size: 13px; color: var(--muted); }
+@keyframes bounce { 0%, 60%, 100% { transform: translateY(0); opacity: .45; } 30% { transform: translateY(-4px); opacity: 1; } }
+
+/* Info panel */
+.info { margin-top: 12px; padding: 16px 18px; background: var(--surface); border: 1px solid var(--line); border-left: 4px solid var(--navy-700); border-radius: 14px; }
+.info h3 { font-size: 14px; margin-bottom: 8px; color: var(--navy-900); }
+.info ol { padding-left: 20px; display: grid; gap: 6px; }
+.info ul { display: grid; gap: 8px; }
+.info ul li { display: flex; gap: 8px; align-items: flex-start; }
+.info ul li ui-icon { color: var(--green); margin-top: 2px; }
+.info .note { margin-top: 10px; font-size: 12.5px; color: var(--muted); }
+
+/* Chips */
+.chips { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 12px; }
+.chip { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 16px; border-radius: 999px; font-weight: 600; font-size: 14px; transition: background .15s, border-color .15s, transform .1s; text-align: left; }
+.chip:active:not(:disabled) { transform: scale(.98); }
+.chip:disabled { opacity: .55; }
+.action, .option { background: var(--surface); border: 1px solid var(--line-strong); color: var(--navy-900); }
+.action:hover:not(:disabled), .option:hover:not(:disabled) { background: var(--navy-50); border-color: var(--navy-700); }
+.action.primary { background: var(--burgundy-600); border-color: var(--burgundy-600); color: #fff; }
+.action.primary:hover:not(:disabled) { background: var(--burgundy-700); border-color: var(--burgundy-700); }
+.follow { margin-top: 14px; }
+.follow > span { font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
+.follow .chips { margin-top: 8px; }
+.follow-chip { background: transparent; border: 1px dashed var(--line-strong); color: var(--navy-800); font-weight: 500; min-height: 40px; }
+.follow-chip:hover:not(:disabled) { background: var(--navy-50); border-style: solid; }
+.retry { display: inline-flex; align-items: center; gap: 8px; margin-top: 12px; min-height: 44px; padding: 0 16px; border-radius: 12px; background: var(--burgundy-600); color: #fff; font-weight: 600; }
+
+/* ---------- Composer ---------- */
+.composer { flex: none; padding: 12px 24px calc(14px + env(safe-area-inset-bottom)); background: linear-gradient(to top, var(--bg) 70%, transparent); }
+.composer-inner { max-width: 820px; margin: 0 auto; display: flex; align-items: center; gap: 10px; padding: 6px 6px 6px 18px; background: var(--surface); border: 1px solid var(--line-strong); border-radius: 20px; box-shadow: var(--shadow-md); }
+.composer-inner:focus-within { border-color: var(--navy-700); box-shadow: 0 0 0 3px rgba(27,65,135,.2), var(--shadow-md); }
+.composer input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; font-size: 16px; padding: 12px 0; }
+.send { display: grid; place-items: center; flex: none; width: 46px; height: 46px; border-radius: 14px; background: var(--navy-900); color: #fff; transition: background .15s; }
+.send:hover:not(:disabled) { background: var(--navy-700); }
+.send:disabled { background: var(--navy-100); color: var(--faint); }
+.guard { max-width: 820px; margin: 8px auto 0; display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--muted); }
+
+/* ---------- Right rail ---------- */
+.rail { overflow-y: auto; padding: 28px 24px 24px 0; display: grid; gap: 16px; align-content: start; }
+.rail-card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-md); padding: 18px; box-shadow: var(--shadow-sm); }
+.rail-card h2 { font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--navy-800); margin-bottom: 12px; }
+.rail dl { display: grid; gap: 10px; }
+.rail dt { font-size: 11px; color: var(--muted); font-weight: 600; letter-spacing: .05em; text-transform: uppercase; }
+.rail dd { margin: 0; font-weight: 600; font-size: 14px; }
+.rules { display: grid; gap: 10px; font-size: 14px; }
+.rules li { display: flex; gap: 8px; align-items: flex-start; }
+.rules ui-icon { color: var(--green); margin-top: 1px; }
+.rules li:last-child ui-icon { color: var(--burgundy-600); }
+.mini { display: grid; gap: 2px; margin: 0 -8px; }
+.mini button { display: flex; align-items: center; justify-content: space-between; gap: 10px; width: 100%; padding: 9px 8px; border-radius: 10px; }
+.mini button:hover:not(:disabled) { background: var(--navy-50); }
+.mini button > span:first-child { display: flex; flex-direction: column; min-width: 0; line-height: 1.3; }
+.mini strong { font-size: 13.5px; }
+.mini small { font-size: 12px; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.empty { font-size: 14px; color: var(--muted); }
+
+/* ---------- Responsive ---------- */
+@media (max-width: 1099px) {
+  .body { grid-template-columns: 1fr; }
+  .rail { display: none; }
+}
+@media (max-width: 640px) {
+  .a-header { padding: 0 12px; gap: 8px; height: 60px; }
+  .mark { display: none; }
+  .titles h1 { font-size: 16px; }
+  .online { font-size: 12px; padding: 5px 10px; }
+  .online .lg { display: none; }
+  .scroller { padding: 18px 14px 8px; }
+  .thread { gap: 18px; }
+  .row.agent { gap: 8px; }
+  .agent-avatar { width: 30px; height: 30px; border-radius: 10px; }
+  .composer { padding: 8px 12px calc(10px + env(safe-area-inset-bottom)); }
+  .guard { font-size: 11.5px; }
+}
