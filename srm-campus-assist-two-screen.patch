+:host { display: block; min-height: 100dvh; }
+
+/* ---------- Top bar ---------- */
+.topbar { position: sticky; top: 0; z-index: 20; background: var(--surface); border-bottom: 1px solid var(--line); }
+.topbar-inner { max-width: 1200px; margin: 0 auto; height: 68px; padding: 0 24px; display: flex; align-items: center; gap: 16px; }
+.brand { display: flex; align-items: center; gap: 12px; min-width: 0; }
+.mark {
+  position: relative; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 10px;
+  background: var(--navy-900); color: #fff; font-weight: 800; font-size: 12px; letter-spacing: 0.02em; overflow: hidden;
+}
+.mark::after { content: ''; position: absolute; left: 8px; right: 8px; bottom: 6px; height: 3px; border-radius: 2px; background: var(--burgundy-600); }
+.brand-text { display: flex; flex-direction: column; line-height: 1.2; min-width: 0; }
+.brand-text strong { font-size: 15px; letter-spacing: 0.01em; color: var(--navy-900); }
+.brand-text span { font-size: 12px; color: var(--muted); white-space: nowrap; }
+.divider { width: 1px; height: 26px; background: var(--line-strong); }
+.product { font-weight: 700; font-size: 15px; color: var(--burgundy-600); white-space: nowrap; }
+.nav { margin-left: 12px; display: flex; gap: 4px; }
+.nav a { padding: 8px 14px; border-radius: 999px; font-weight: 600; font-size: 14px; color: var(--muted); transition: background 0.15s, color 0.15s; }
+.nav a:hover { background: var(--navy-50); color: var(--navy-900); }
+.nav a.active { background: var(--navy-100); color: var(--navy-900); }
+.tools { margin-left: auto; display: flex; align-items: center; gap: 12px; }
+.icon-btn { position: relative; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 999px; color: var(--navy-900); transition: background 0.15s; }
+.icon-btn:hover { background: var(--navy-50); }
+.dot { position: absolute; top: 10px; right: 11px; width: 9px; height: 9px; border-radius: 50%; background: var(--burgundy-600); border: 2px solid #fff; }
+.avatar { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--navy-100); color: var(--navy-900); font-weight: 700; border: 1px solid var(--navy-200); }
+.notif { position: relative; }
+.popover {
+  position: absolute; right: 0; top: calc(100% + 8px); width: min(340px, calc(100vw - 32px));
+  background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-md); box-shadow: var(--shadow-md); padding: 8px;
+}
+.pop-title { display: flex; align-items: center; justify-content: space-between; padding: 8px 10px; font-weight: 700; font-size: 14px; }
+.notif-item { display: flex; flex-direction: column; gap: 2px; width: 100%; padding: 10px; border-radius: 12px; transition: background 0.15s; }
+.notif-item:hover { background: var(--navy-50); }
+.notif-item.unread { background: var(--burgundy-50); }
+.notif-text { font-size: 14px; }
+.notif-time { font-size: 12px; color: var(--muted); }
+.empty-small { padding: 12px 10px; color: var(--muted); font-size: 14px; }
+
+/* ---------- Page ---------- */
+.page { max-width: 1200px; margin: 0 auto; padding: 24px 24px 40px; }
+
+/* ---------- Hero ---------- */
+.hero {
+  position: relative; overflow: hidden; border-radius: var(--radius-lg); background: var(--navy-900); color: #fff;
+  padding: clamp(28px, 5vw, 56px); display: grid; gap: 24px;
+  background-image: radial-gradient(rgba(255, 255, 255, 0.07) 1px, transparent 1px);
+  background-size: 22px 22px;
+}
+.hero::before { content: ''; position: absolute; left: clamp(28px, 5vw, 56px); top: 0; width: 64px; height: 5px; background: var(--burgundy-600); border-radius: 0 0 4px 4px; }
+.hero-copy { display: grid; gap: 10px; max-width: 720px; }
+.hero h1 { font-size: clamp(30px, 5vw, 48px); line-height: 1.1; letter-spacing: -0.03em; font-weight: 800; }
+.lead { font-size: clamp(18px, 2.4vw, 24px); font-weight: 600; color: #fff; }
+.sub { color: #c4d0e8; font-size: 16px; max-width: 560px; }
+
+.ask {
+  display: flex; align-items: center; gap: 12px; background: #fff; color: var(--text); border-radius: 20px;
+  padding: 8px 8px 8px 20px; min-height: 68px; box-shadow: 0 12px 32px rgba(0, 0, 0, 0.25); max-width: 820px;
+  transition: box-shadow 0.15s;
+}
+.ask:focus-within { box-shadow: 0 0 0 4px rgba(163, 33, 58, 0.55), 0 12px 32px rgba(0, 0, 0, 0.25); }
+.ask-lead { color: var(--burgundy-600); }
+.ask input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; font-size: 18px; padding: 12px 0; }
+.ask input::placeholder { color: var(--faint); }
+.ask-btn { display: grid; place-items: center; width: 52px; height: 52px; flex: none; border-radius: 14px; background: var(--burgundy-600); color: #fff; transition: background 0.15s, transform 0.1s; }
+.ask-btn:hover:not(:disabled) { background: var(--burgundy-700); }
+.ask-btn:active:not(:disabled) { transform: scale(0.96); }
+.ask-btn:disabled { background: var(--navy-100); color: var(--faint); }
+
+.prompts { display: flex; flex-wrap: wrap; gap: 10px; max-width: 900px; }
+.prompt {
+  padding: 10px 16px; border-radius: 999px; font-size: 14px; font-weight: 500; color: #fff; min-height: 40px;
+  background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.22); transition: background 0.15s, border-color 0.15s;
+}
+.prompt:hover { background: rgba(255, 255, 255, 0.2); border-color: rgba(255, 255, 255, 0.45); }
+.hero :focus-visible { outline-color: #fff; }
+
+/* ---------- Grid ---------- */
+.grid { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 32px; margin-top: 40px; align-items: start; }
+.section-head { margin-bottom: 16px; }
+h2 { font-size: 20px; letter-spacing: -0.01em; font-weight: 700; }
+.section-head p { color: var(--muted); font-size: 14px; margin-top: 2px; }
+
+.service-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; }
+.service { display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-md); box-shadow: var(--shadow-sm); transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s; }
+.service:hover, .service:focus-within { border-color: var(--navy-200); box-shadow: var(--shadow-md); }
+.service-main { display: flex; align-items: flex-start; gap: 14px; padding: 18px 16px 12px 18px; width: 100%; border-radius: var(--radius-md); }
+.s-icon { display: grid; place-items: center; flex: none; width: 44px; height: 44px; border-radius: 12px; background: var(--navy-50); color: var(--navy-800); }
+.service:hover .s-icon { background: var(--navy-900); color: #fff; }
+.s-body { display: flex; flex-direction: column; gap: 2px; flex: 1; min-width: 0; }
+.s-body strong { font-size: 16px; color: var(--navy-900); }
+.s-body span { font-size: 13px; color: var(--muted); }
+.chev { color: var(--faint); margin-top: 12px; transition: transform 0.15s, color 0.15s; }
+.service:hover .chev { color: var(--burgundy-600); transform: translateX(2px); }
+.topics { display: flex; flex-wrap: wrap; gap: 8px; padding: 0 18px 16px 76px; }
+.topic { font-size: 12.5px; font-weight: 600; color: var(--navy-800); padding: 6px 12px; border-radius: 999px; background: var(--navy-50); border: 1px solid var(--navy-100); min-height: 32px; transition: background 0.15s, border-color 0.15s; }
+.topic:hover { background: var(--burgundy-50); border-color: #ebc3cb; color: var(--burgundy-700); }
+
+/* ---------- Side panels ---------- */
+.side { display: grid; gap: 20px; }
+.panel { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-md); padding: 20px; box-shadow: var(--shadow-sm); }
+.panel-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px; }
+.status-list { display: grid; }
+.status-list li { display: flex; align-items: center; gap: 12px; padding: 11px 0; border-top: 1px solid var(--line); }
+.status-list li:first-child { border-top: 0; }
+.st-icon { display: grid; place-items: center; flex: none; width: 32px; height: 32px; border-radius: 10px; background: var(--navy-50); color: var(--navy-800); }
+.st-icon.ok { background: var(--green-50); color: var(--green); }
+.st-icon.warn { background: var(--amber-50); color: var(--amber); }
+.st-text { display: flex; flex-direction: column; flex: 1; min-width: 0; line-height: 1.3; }
+.st-text strong { font-size: 14px; }
+.st-text span { font-size: 13px; color: var(--muted); }
+.st-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--navy-700); }
+.st-dot.ok { background: #2fa36b; }
+.st-dot.warn { background: #d98a1a; }
+
+.req-list { display: grid; gap: 4px; margin: 0 -8px; }
+.req { display: flex; align-items: center; gap: 12px; width: 100%; padding: 10px 8px; border-radius: 12px; transition: background 0.15s; min-height: 56px; }
+.req:hover { background: var(--navy-50); }
+.req-icon { display: grid; place-items: center; flex: none; width: 36px; height: 36px; border-radius: 10px; background: var(--navy-50); color: var(--navy-800); }
+.req-text { display: flex; flex-direction: column; flex: 1; min-width: 0; line-height: 1.3; }
+.req-text strong { font-size: 14px; }
+.req-text span { font-size: 12px; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.empty { display: grid; justify-items: center; gap: 8px; padding: 20px 8px; text-align: center; color: var(--muted); font-size: 14px; }
+
+.footnote { text-align: center; color: var(--faint); font-size: 12.5px; margin-top: 40px; }
+
+/* ---------- Responsive ---------- */
+@media (max-width: 1023px) {
+  .grid { grid-template-columns: 1fr; gap: 28px; }
+  .side { grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; }
+}
+@media (max-width: 720px) {
+  .topbar-inner { padding: 0 16px; gap: 12px; height: 60px; }
+  .divider, .nav { display: none; }
+  .brand-text span { display: none; }
+  .page { padding: 16px 16px 32px; }
+  .hero { border-radius: 20px; }
+  .side { grid-template-columns: 1fr; }
+  .ask { min-height: 60px; padding-left: 14px; }
+  .ask input { font-size: 16px; }
+  .ask-btn { width: 46px; height: 46px; }
+  .topics { padding-left: 18px; }
+  .service-grid { grid-template-columns: 1fr; }
+}
