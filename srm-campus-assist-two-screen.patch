+<header class="topbar">
+  <div class="topbar-inner">
+    <a class="brand" routerLink="/home" aria-label="SRM Campus Assist — Home">
+      <span class="mark" aria-hidden="true">SRM</span>
+      <span class="brand-text">
+        <strong>SRMIST</strong>
+        <span>Kattankulathur Campus</span>
+      </span>
+    </a>
+    <span class="divider" aria-hidden="true"></span>
+    <span class="product">Campus Assist</span>
+
+    <nav class="nav" aria-label="Primary">
+      <a routerLink="/home" routerLinkActive="active" ariaCurrentWhenActive="page">Home</a>
+    </nav>
+
+    <div class="tools">
+      <div class="notif">
+        <button type="button" class="icon-btn" (click)="notifOpen.set(!notifOpen()); $event.stopPropagation()"
+          [attr.aria-expanded]="notifOpen()" aria-haspopup="dialog"
+          [attr.aria-label]="unreadCount() ? 'Notifications, ' + unreadCount() + ' unread' : 'Notifications'">
+          <ui-icon name="bell" [size]="20" />
+          @if (unreadCount()) { <span class="dot" aria-hidden="true"></span> }
+        </button>
+        @if (notifOpen()) {
+          <div class="popover" role="dialog" aria-label="Notifications">
+            <p class="pop-title">Notifications <span class="demo-pill">Demo</span></p>
+            @for (n of data.notifications(); track n.id) {
+              <button type="button" class="notif-item" [class.unread]="n.unread" (click)="openNotification(n.id, n.requestId)">
+                <span class="notif-text">{{ n.text }}</span>
+                <span class="notif-time">{{ ago(n.at) }}</span>
+              </button>
+            } @empty {
+              <p class="empty-small">You're all caught up.</p>
+            }
+          </div>
+        }
+      </div>
+      <span class="avatar" [attr.title]="data.student.fullName" role="img" [attr.aria-label]="'Profile: ' + data.student.fullName">{{ data.student.initials }}</span>
+    </div>
+  </div>
+</header>
+
+<main class="page">
+  <section class="hero" aria-labelledby="hero-title">
+    <div class="hero-copy">
+      <h1 id="hero-title">{{ greeting }}, {{ data.student.firstName }} <span aria-hidden="true">👋</span></h1>
+      <p class="lead">How can Campus Assist help you today?</p>
+      <p class="sub">Ask questions, find campus services, or get help with a student request.</p>
+    </div>
+
+    <form class="ask" role="search" (submit)="$event.preventDefault(); ask()">
+      <ui-icon class="ask-lead" name="sparkles" [size]="22" />
+      <input type="text" name="q" autocomplete="off" enterkeyhint="send"
+        aria-label="Ask anything about SRMIST" placeholder="Ask anything about SRMIST..."
+        [value]="query()" (input)="query.set($any($event.target).value)" />
+      <button type="submit" class="ask-btn" [disabled]="!query().trim()" aria-label="Ask Campus Assist">
+        <ui-icon name="arrow-up" [size]="20" />
+      </button>
+    </form>
+
+    <div class="prompts" role="group" aria-label="Suggested questions">
+      @for (p of data.suggestedPrompts; track p) {
+        <button type="button" class="prompt" (click)="prompt(p)">{{ p }}</button>
+      }
+    </div>
+  </section>
+
+  <div class="grid">
+    <section class="services" aria-labelledby="services-title">
+      <div class="section-head">
+        <h2 id="services-title">Quick services</h2>
+        <p>Pick a service and Campus Assist starts with the right context.</p>
+      </div>
+      <ul class="service-grid">
+        @for (s of data.services; track s.id) {
+          <li class="service">
+            <button type="button" class="service-main" (click)="openService(s)">
+              <span class="s-icon"><ui-icon [name]="s.icon" [size]="22" /></span>
+              <span class="s-body">
+                <strong>{{ s.title }}</strong>
+                <span>{{ s.description }}</span>
+              </span>
+              <ui-icon class="chev" name="chevron-right" [size]="18" />
+            </button>
+            <div class="topics" role="group" [attr.aria-label]="s.title + ' shortcuts'">
+              @for (t of s.topics; track t.context) {
+                <button type="button" class="topic" (click)="openContext(t.context)">{{ t.label }}</button>
+              }
+            </div>
+          </li>
+        }
+      </ul>
+    </section>
+
+    <aside class="side">
+      <section class="panel" aria-labelledby="today-title">
+        <div class="panel-head">
+          <h2 id="today-title">Campus today</h2>
+          <span class="demo-pill" title="Sample data for this demo">Demo data</span>
+        </div>
+        <ul class="status-list">
+          @for (item of data.campusToday; track item.id) {
+            <li>
+              <span class="st-icon" [class]="'st-icon ' + item.tone"><ui-icon [name]="item.icon" [size]="16" /></span>
+              <span class="st-text"><strong>{{ item.label }}</strong><span>{{ item.value }}</span></span>
+              <span class="st-dot" [class]="'st-dot ' + item.tone" aria-hidden="true"></span>
+            </li>
+          }
+        </ul>
+      </section>
+
+      <section class="panel" aria-labelledby="recent-title">
+        <div class="panel-head">
+          <h2 id="recent-title">Recent requests</h2>
+        </div>
+        @if (recent().length) {
+          <ul class="req-list">
+            @for (r of recent(); track r.id) {
+              <li>
+                <button type="button" class="req" (click)="openRequest(r)">
+                  <span class="req-icon"><ui-icon [name]="serviceIcon(r)" [size]="18" /></span>
+                  <span class="req-text">
+                    <strong>{{ r.title }}</strong>
+                    <span>{{ r.id }} · {{ ago(r.updatedAt) }}</span>
+                  </span>
+                  <span class="badge" [class]="'badge ' + tone(r.status)">{{ r.status }}</span>
+                </button>
+              </li>
+            }
+          </ul>
+        } @else {
+          <div class="empty">
+            <ui-icon name="inbox" [size]="26" />
+            <p>No requests yet. Ask Campus Assist to start one.</p>
+          </div>
+        }
+      </section>
+    </aside>
+  </div>
+
+  <p class="footnote">Demo build · sample data only · not an official SRMIST service.</p>
+</main>
