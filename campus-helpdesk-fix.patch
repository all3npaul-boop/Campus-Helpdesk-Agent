+    def _deny(self, ticket: Ticket, result: AgentResult, decision) -> AgentResult:
+        """Close with a NO, but only when the policy file itself says no and the fee evidence was gathered.
+
+        The reply is the policy's own statement, quoted verbatim - the agent never writes a rule.
+        """
+        called = {entry["tool"] for entry in result.tool_results}
+        problems = []
+        if "check_fee_status" not in called:
+            problems.append("missing tool evidence: check_fee_status")
+        if result.tool_errors:
+            problems.append("a tool reported an error")
+        if result.forbidden_action_detected:
+            problems.append("a forbidden request was detected")
+        if problems:
+            return self._escalate(result, "CLOSURE_GATE_FAILED", "Closure blocked: " + "; ".join(problems), ticket)
+        result.outcome = Outcome.DENIED_BY_POLICY
+        result.was_closed_without_human = True
+        result.human_confirmation_required = False
+        result.action_executed = None
+        result.denial = {"rule": decision.rule, "statement": decision.reason, "policy_version": decision.policy_version}
+        result.trace.append(f"Policy rule '{decision.rule}' says NO; policy statement quoted verbatim, nothing invented")
+        result.trace.append("Ticket closed with a policy-based denial: rule explicit and fee evidence present")
+        return result
